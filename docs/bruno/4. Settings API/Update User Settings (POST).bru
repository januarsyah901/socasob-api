meta {
  name: Update User Settings (POST)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "robotId": "{{robotId}}",
    "robotIp": "{{robotIp}}",
    "audioVolume": 70,
    "audioEnabled": true,
    "notificationEnabled": true
  }
}

assert {
  res.status: in [200, 400, 401]
  res.body.success: isDefined
}

tests {
  test("update user settings post response handled", function() {
    expect([200, 400, 401]).to.include(res.getStatus());
  });
}

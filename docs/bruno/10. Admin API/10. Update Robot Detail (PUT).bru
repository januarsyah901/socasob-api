meta {
  name: 10. Update Robot Detail (PUT)
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/admin/robots/fadfa566
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "name": "SocaSob Primary Robot",
    "serialNumber": "SOCA-X7B9",
    "ipAddress": "192.168.1.100",
    "status": "active"
  }
}

assert {
  res.status: in [200, 401, 403, 404]
}

tests {
  test("update robot detail admin handled", function() {
    expect([200, 401, 403, 404]).to.include(res.getStatus());
  });
}

meta {
  name: 4. Update User (PUT)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/admin/users/60d5ec49f1b2c80015f8e4a1
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "fullName": "User Admin Updated",
    "phoneNumber": "081299990000"
  }
}

assert {
  res.status: in [200, 400, 401, 403, 404]
}

tests {
  test("update user admin handled", function() {
    expect([200, 400, 401, 403, 404]).to.include(res.getStatus());
  });
}

meta {
  name: 3. Get User Detail (GET)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/admin/users/60d5ec49f1b2c80015f8e4a1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

assert {
  res.status: in [200, 401, 403, 404]
}

tests {
  test("get user detail response handled", function() {
    expect([200, 401, 403, 404]).to.include(res.getStatus());
  });
}

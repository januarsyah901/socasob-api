meta {
  name: 5. Change User Role (PUT)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/admin/users/60d5ec49f1b2c80015f8e4a1/role
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "role": "admin"
  }
}

assert {
  res.status: in [200, 400, 401, 403, 404]
}

tests {
  test("change user role admin handled", function() {
    expect([200, 400, 401, 403, 404]).to.include(res.getStatus());
  });
}

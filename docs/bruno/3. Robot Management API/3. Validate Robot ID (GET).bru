meta {
  name: 3. Validate Robot ID (GET)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/robots/validate/{{robotId}}
  body: none
  auth: none
}

assert {
  res.status: in [200, 404]
  res.body.valid: isDefined
}

tests {
  test("validate robot response valid", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

meta {
  name: 5. Update Robot (PUT)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/api/robots/robot-demo-01
  body: json
  auth: none
}

body:json {
  {
    "name": "Robot SocaSob Updated",
    "ipAddress": "192.168.1.125",
    "description": "Perangkat uji diperbarui",
    "status": "active"
  }
}

assert {
  res.status: in [200, 404]
  res.body.success: isDefined
}

tests {
  test("update robot handled", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

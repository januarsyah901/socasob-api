meta {
  name: Generate Medical Report (POST)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/reports
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "robotId": "{{robotId}}",
    "patientName": "Bang Jan",
    "period": "7days"
  }
}

assert {
  res.status: eq 201
  res.body.success: eq true
  res.body.data._id: isDefined
}

tests {
  test("medical report generated", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().success).to.be.true;
  });
}

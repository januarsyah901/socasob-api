meta {
  name: 5. Get Latest Extracted Features (GET)
  type: http
  seq: 5
}

get {
  url: {{mlUrl}}/api/features
  body: none
  auth: none
}

assert {
  res.status: in [200, 404]
}

tests {
  test("features endpoint responded", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

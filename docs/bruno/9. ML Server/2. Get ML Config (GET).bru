meta {
  name: 2. Get ML Config (GET)
  type: http
  seq: 2
}

get {
  url: {{mlUrl}}/api/config
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data: isDefined
}

tests {
  test("get ml config returned settings", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

meta {
  name: Get Robot System Health
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/robot/health?robotId={{robotId}}
  body: none
  auth: none
}

params:query {
  robotId: {{robotId}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.robotId: isDefined
  res.body.data.blinkRate: isDefined
}

tests {
  test("robot telemetry health is fetched", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

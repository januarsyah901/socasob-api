meta {
  name: Frontend Health Check
  type: http
  seq: 2
}

get {
  url: {{feUrl}}/health
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.status: eq healthy
}

tests {
  test("frontend is healthy", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("healthy");
  });
}

meta {
  name: Get Today Log
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/log/today?robotId={{robotId}}
  body: none
  auth: none
}

params:query {
  robotId: {{robotId}}
}

assert {
  res.status: in [200, 404]
  res.body.success: isDefined
}

tests {
  test("today log endpoint responded", function() {
    expect([200, 404]).to.include(res.getStatus());
  });
}

meta {
  name: Create Manual Log Entry (POST)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/log/manual
  body: json
  auth: none
}

body:json {
  {
    "robotId": "{{robotId}}",
    "date": "{{testDate}}",
    "nearDuration": 120,
    "farDuration": 300,
    "blinkCount": 45,
    "eyeHealthStatus": "Sangat Baik"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("manual log entry created", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

meta {
  name: Get Weekly Logs
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/log/weekly?robotId={{robotId}}
  body: none
  auth: none
}

params:query {
  robotId: {{robotId}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("weekly logs fetched", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.be.true;
  });
}

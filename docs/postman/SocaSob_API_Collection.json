	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Otomatis set tanggal hari ini YYYY-MM-DD",
					"const now = new Date();",
					"const year = now.getFullYear();",
					"const month = String(now.getMonth() + 1).padStart(2, '0');",
					"const day = String(now.getDate()).padStart(2, '0');",
					"pm.collectionVariables.set('currentDate', `${year}-${month}-${day}`);"
				],
				"type": "text/javascript"
			}
		},
